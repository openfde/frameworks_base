<!--
  fde: copy of the fullscreen app handle bar that is drawn inside the "Handle Input Layer"
  window. That window is layered above the status bar (AdditionalSystemViewContainer), while
  the caption itself lives underneath it, so this copy is what keeps the handle clearly visible.
  Geometry matches the in-caption handle: same bar thickness, same horizontal padding and the
  same vertical offset (desktop_mode_fullscreen_decor_caption_vertical_padding).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_handle_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.android.wm.shell.windowdecor.HandleImageButton
        android:id="@+id/caption_handle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_handle_height"
        android:layout_gravity="top"
        android:layout_marginTop="@dimen/desktop_mode_fullscreen_decor_caption_vertical_padding"
        android:paddingHorizontal="@dimen/desktop_mode_fullscreen_decor_caption_horizontal_padding_default"
        android:src="@drawable/decor_handle_dark"
        android:background="@android:color/transparent"
        android:scaleType="fitXY"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:contentDescription="@null"/>
</FrameLayout>
